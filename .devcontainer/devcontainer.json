{
  "name": "CQ Housing Analysis Dev",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "updateRemoteUserUID": false,
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "forwardPorts": [
    5173,
    8000,
    80,
    9443,
    5432
  ],
  "portsAttributes": {
    "5173": {
      "label": "Frontend Dev",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "8000": {
      "label": "Backend API",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "80": {
      "label": "Frontend Nginx",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "9443": {
      "label": "Portainer",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "postCreateCommand": "bash cq-housing-analysis/scripts/setup_local.sh || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "Vue.volar",
        "ms-azuretools.vscode-docker",
        "nisheetjain.emacs",
        "letrieu.expand-region"
      ]
    }
  }
}